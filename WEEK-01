#include<iostream>
using namespace std;
int sum(int a[],int n){
	int sum=0;
	for(int i=0;i<n;i++){
		sum=sum+a[i];
	}
	cout<<"SUM = "<<sum<<endl;
	return sum;
}
int average(int a[],int n){
	int avg;
	avg=sum(a,n)/n;
	cout<<"AVG = "<<avg<<endl;
	return avg;
}
int main(){
	int a[100], n;
	cout<<"enter size of array\n";
	cin>>n;
	cout<<"enter array\n";
	for(int i=0;i<n;i++)
	cin>>a[i];
	average(a,n);
}
